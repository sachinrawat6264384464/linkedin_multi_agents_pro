# ==============================================================================
# LINKEDIN AGENTOS - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Environment
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=agentos-dev-super-secret-key-change-in-production-32chars
JWT_SECRET_KEY=jwt-agentos-secret-key-must-be-very-long-and-secure-32chars
APP_ENCRYPTION_KEY=dGhpcy1pcy1hLXNhbXBsZS0zMmJ5dGUtZW5jcnlwdGlvbi1rZXk=

# Server Binding
HOST=0.0.0.0
PORT=8000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Primary Database (Neon PostgreSQL)
# Format: postgresql+asyncpg://<user>:<password>@<host>/<dbname>?ssl=require
DATABASE_URL=postgresql+asyncpg://neondb_owner:npg_placeholder@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?ssl=require
# Direct database URL for Alembic DDL migrations (non-pooler):
DATABASE_URL_DIRECT=postgresql+psycopg2://neondb_owner:npg_placeholder@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Local LLM Execution (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_TIMEOUT=120

# LinkedIn OAuth 2.0 (Official Integration)
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/v1/publishing/oauth/callback

# Web Search Provider (Tavily or Mock/DuckDuckGo)
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=tvly-your-tavily-api-key

# Optional Langfuse Monitoring / Telemetry
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

